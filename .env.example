# Copie para .env e preencha com os dados do painel do Supabase (Project Settings > API).
# Use a chave pública (anon/publishable). A chave de administrador (service_role) nunca entra aqui.
# Sem estes valores, o app abre em modo de exemplo, com dados fictícios.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
